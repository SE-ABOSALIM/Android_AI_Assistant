DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/android-ai-assistant
PSQL_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/android-ai-assistant
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PREDICT_REQUESTS=60
RATE_LIMIT_PREDICT_WINDOW_SECONDS=60
RATE_LIMIT_APP_CATALOG_REQUESTS=12
RATE_LIMIT_APP_CATALOG_WINDOW_SECONDS=60
RATE_LIMIT_CUSTOM_COMMAND_REQUESTS=60
RATE_LIMIT_CUSTOM_COMMAND_WINDOW_SECONDS=60
RATE_LIMIT_REGISTRATION_REQUESTS=20
RATE_LIMIT_REGISTRATION_WINDOW_SECONDS=3600
MAX_REQUEST_BODY_BYTES=2097152
